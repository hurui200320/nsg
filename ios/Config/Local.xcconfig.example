// Required: your unique application identifier in reverse-DNS format.
NSG_APP_BUNDLE_ID = com.yourname.nsg

// Required: the Team ID of your signed-in Apple account (not its display name).
// ABCDE12345 is a placeholder showing the 10-character format.
NSG_SIGNING_TEAM = ABCDE12345
